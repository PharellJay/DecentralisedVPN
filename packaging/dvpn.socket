[Unit]
Description=dvpn control socket

[Socket]
ListenStream=/run/dvpn/control.sock
# Anyone may connect; the service itself decides whom it answers: people signed in at
# this computer (polkit action dev.dvpn.control) and members of the dvpn group.
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
