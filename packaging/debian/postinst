#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # The service's user, and its group whose members control the service
    # (packaging/dvpn.sysusers).
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers dvpn.conf
    elif ! getent passwd dvpn >/dev/null; then
        getent group dvpn >/dev/null || groupadd --system dvpn
        useradd --system --gid dvpn --home-dir /var/lib/dvpn --no-create-home \
            --shell /usr/sbin/nologin --comment "dvpn VPN service" dvpn
    fi

    # Whoever installed the package (via sudo, or pkexec from a software centre)
    # gets control of the VPN, so the app works without further setup.
    installer="${SUDO_USER:-}"
    if [ -z "$installer" ] && [ -n "${PKEXEC_UID:-}" ]; then
        installer="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
    fi
    if [ -n "$installer" ] && [ "$installer" != "root" ] && id "$installer" >/dev/null 2>&1; then
        if ! id -nG "$installer" | tr ' ' '\n' | grep -qx dvpn; then
            usermod -aG dvpn "$installer"
            echo "dvpn: added $installer to the dvpn group."
        fi
    fi
    # Nothing else to set up: whoever is signed in at this computer can use the dvpn app
    # (polkit), and group membership applies at once, without logging out.

    # Every install, upgrade or reinstall asks for the lending terms again (the file is
    # CONSENT_FILE in src/lend.rs). Nothing lends until they're accepted in the app; then
    # lending at boot, if it's on, picks up again without a restart.
    rm -f /var/lib/dvpn/exit-risk-accepted
fi

#DEBHELPER#
