[Desktop Entry]
Type=Application
Name=dvpn
GenericName=Peer-to-peer VPN
Comment=Connect to the dvpn network and lend your connection in return
Exec=dvpn-gui %u
Icon=dvpn
Terminal=false
Categories=Network;Security;
Keywords=vpn;privacy;p2p;
StartupWMClass=dvpn-gui
# Invite links (dvpn://join?…) open the app, which asks before adding them.
MimeType=x-scheme-handler/dvpn;
